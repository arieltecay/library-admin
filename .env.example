# Vite Environment Variables
# These are injected via Vite's process.env

# API Base URL
# In development: use local server URL
# In production: set this to your Vercel API URL, or leave as /api if both frontend and backend are on Vercel
VITE_API_BASE_URL="/api"

# POS Base URL (for POS login URLs)
# In development: use local POS frontend URL
# In production: REQUIRED - set this to your POS frontend URL (e.g., https://pos.tudominio.com)
# This MUST be configured in your Vercel frontend project settings
VITE_POS_BASE_URL="http://localhost:5173"

# Application name
VITE_APP_NAME="Library System Admin"